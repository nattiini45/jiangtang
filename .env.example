# --- Core ---
DATABASE_URL="postgresql://jiangtang:jiangtang@localhost:5432/jiangtang?schema=public"
TZ="Europe/Berlin"
# HTTP port of the Express server (default 3000).
# PORT=3000

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET="change-me-generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Storage (local encrypted filesystem behind the StorageProvider interface) ---
STORAGE_DIR="./data/uploads"
# Development only: unset = an INSECURE built-in dev key (a warning is logged).
# Production requires a real key; generate with `openssl rand -hex 32`.
# STORAGE_ENCRYPTION_KEY=""
# Optional salt for a passphrase-style STORAGE_ENCRYPTION_KEY (anything but 64 hex characters).
# Set it only on a fresh installation: changing it changes the derived key.
# STORAGE_KEY_SALT=""

# --- Calendar push (CalDAV, output-only, RFC 4791). Empty = publisher idle (Noop). ---
# CALDAV_URL="https://calendar.example.org/dav/calendars/av-team/veranstaltungen/"
# CALDAV_USERNAME="av-team"
# CALDAV_PASSWORD="app-passwort"

# --- First-admin bootstrap ---
# Acts only while no active ADMIN exists (first install, or recovery after a full lockout);
# once an active admin exists these values are ignored. Blank = no bootstrap. On recovery, an
# existing ADMIN_EMAIL account is re-elevated only when ADMIN_PASSWORD matches its current password.
# A forgotten password is reset with a one-time link instead (docs/DEPLOY.md, "Forgotten passwords").
# ADMIN_EMAIL="admin@example.org"
# ADMIN_PASSWORD="change-me-a-strong-password"
# ADMIN_INITIALS="AD"

# --- Development admin (pnpm dev only: NODE_ENV=development) ---
# Created on the first `pnpm dev` when no account holds the address. Without overrides the
# built-in identity is admin@jiangtang.local with the password jiangtang-admin. Unsafe for any
# public exposure. Set these only to replace that identity, and do not set them in production.
# DEV_ADMIN_EMAIL="admin@jiangtang.local"
# DEV_ADMIN_PASSWORD="jiangtang-admin"

# --- iCal feed (self-hosted, token-gated) ---
# Generate a long random token; calendar clients subscribe via /calendar/<token>/ics
ICAL_FEED_TOKEN="generate-a-long-random-token-here"

# --- Observability ---
# Self-hosted GlitchTip DSN (Sentry-compatible). Empty = no error tracking (dev).
GLITCHTIP_DSN=""
# pino structured-logging level (trace/debug/info/warn/error).
LOG_LEVEL="info"
# Workspace language: en | de (default en). Fallback UI language for visitors without a language
# cookie or browser preference, and the language of server-generated text: demo seed data,
# search-index meta lines, the Ask prompt and the iCal feed name.
DEFAULT_LOCALE="en"
# Mattermost/Slack-compatible webhook for downtime pages. Empty = alerting idle.
ALERT_WEBHOOK=""

# --- GDPR retention ---
# ActivityLog rows older than this many days are pruned by the daily retention job.
ACTIVITY_RETENTION_DAYS="2555"

# --- Inventory ---
# Look-ahead window in days for warranties that are about to expire (default 30).
WARRANTY_WINDOW_DAYS="30"

# --- PITR backups (WAL-G → S3-compatible target) ---
# Leave unset for local/dev (postgres-only, no archiving). Production sets these
# to point at the S3-compatible backup target.
# WALG_S3_PREFIX="s3://jiangtang-backups/postgres"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ENDPOINT=""           # non-AWS S3-compatible backends (Garage/RustFS/MinIO)
# AWS_REGION="eu-central-1"
# Number of FULL base backups to keep (a count, not days). Default 7. Empty is rejected.
# WALG_RETENTION_COUNT="7"
# Set to 1 to run the monthly restore drill inside the backup sidecar (default OFF).
RESTORE_DRILL_ENABLED=""
# Public landing page at /welcome; off unless "1".
LANDING_PAGE_ENABLED=""

# --- AI seams (OpenAI-compatible endpoints; unset = capability off) ---
# Resolution keys on the BASE_URL per capability — a keyless self-hosted
# endpoint (vLLM/Ollama) is valid; API_KEY is optional.
# EMBEDDING_BASE_URL="http://127.0.0.1:8080/v1"
# EMBEDDING_MODEL="Qwen3-Embedding-8B"
# EMBEDDING_API_KEY=""                    # optional Bearer token
# EMBEDDING_DIMENSIONS="1024"             # fixed by the vector(1024) column — anything else is refused
# EMBEDDING_SEND_DIMENSIONS="true"        # false if the endpoint rejects a `dimensions` parameter
# EMBEDDING_QUERY_TEMPLATE="Instruct: {instruction}\nQuery:{text}"
# EMBEDDING_QUERY_INSTRUCTION="Given a search query in an AV and facility management workspace, retrieve the records that answer the query"
# EMBEDDING_PASSAGE_TEMPLATE="{text}"
# RERANK_BASE_URL=""                      # Cohere/Jina/vLLM-style /rerank endpoint
# RERANK_MODEL=""
# RERANK_API_KEY=""
# GENERATION_BASE_URL=""                  # OpenAI-compatible /chat/completions
# GENERATION_MODEL=""
# GENERATION_API_KEY=""
# GENERATION_MAX_TOKENS="800"
# GENERATION_SYSTEM_ROLE="system"         # or "merge" — folds the system text into the first user message
# SEARCH_INDEXER=""                       # "off" disables the background indexer

# --- Test and tooling overrides (see CONTRIBUTING.md) ---
# Database for `pnpm test`, instead of the derived `<DATABASE_URL database>_test`. Must end in
# `_test`. The Vitest harness reads the shell environment, not this file.
# DATABASE_URL_TEST="postgresql://jiangtang:jiangtang@localhost:5432/jiangtang_test?schema=public"
# Database for the browser suite. Must end in `_e2e`.
# DATABASE_URL_E2E="postgresql://jiangtang:jiangtang@localhost:5432/jiangtang_e2e?schema=public"
# Origin the browser suite serves, loopback only (default http://localhost:3100).
# E2E_BASE_URL="http://localhost:3100"
# Shadow database for `prisma migrate dev`. Must differ from DATABASE_URL; derived when unset.
# SHADOW_DATABASE_URL="postgresql://jiangtang:jiangtang@localhost:5432/jiangtang_shadow?schema=public"
