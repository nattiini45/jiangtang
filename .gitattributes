# Normalize line endings. The container migrate job and shell scripts run on
# Linux; Windows CRLF would corrupt SQL heredocs and shell scripts.
* text=auto eol=lf

# Force LF on files executed/parsed inside the Linux image.
*.sql   text eol=lf
*.sh    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
