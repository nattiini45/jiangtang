# Reverse proxy → app. APP_DOMAIN is required by docker-compose.yml: a real hostname
# enables automatic TLS, and ":80" serves plain HTTP (local or rehearsal only). NO `encode` block: gzip/zstd buffering would break
# SSE (text/event-stream), which is the live-update transport. `flush_interval -1`
# streams responses immediately (SSE + streamed SSR pass through unbuffered).
{$APP_DOMAIN} {
	# Baseline browser hardening. Browsers ignore Strict-Transport-Security sent over
	# plain HTTP, so it is harmless on the ":80" rehearsal/local listener. No header
	# here buffers or compresses a response, so SSE streams are unaffected.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
	}
	# Drop oversized request bodies at the proxy (image uploads cap at 15MB
	# app-side; 20MB leaves margin for multipart overhead) so a huge POST can't
	# reach Node and be buffered into memory.
	request_body {
		max_size 20MB
	}
	# Compress only the immutable build assets. App responses — including the
	# SSE stream — stay uncompressed and unbuffered (flush_interval -1 below),
	# because encode buffers, which would break text/event-stream.
	@assets path /assets/*
	encode zstd gzip @assets
	reverse_proxy app:3000 {
		flush_interval -1
	}
}
