# Jiangtang — production environment (docker-compose.yml interpolates this file).
# Copy to .env on the VPS, fill the required block, and never commit the copy.
# Every variable the production compose file reads is listed below; empty or
# absent optional values fall back to the compose defaults shown inline.

# ── Required ──────────────────────────────────────────────────────────────────
# Better Auth session signing key, at least 32 characters. Generate: openssl rand -base64 48
# The app refuses to boot in production when it is shorter or is a placeholder.
BETTER_AUTH_SECRET=
# Public origin of the app — must match APP_DOMAIN (cookies, invitation links).
BETTER_AUTH_URL=https://jiangtang.example.org
# Hostname Caddy serves + requests TLS for (DNS A record → the VPS). ":80" = plain HTTP.
APP_DOMAIN=jiangtang.example.org
# Postgres credentials for the bundled database container. Required: there is no
# built-in fallback password. Generate with: openssl rand -hex 24 (hex keeps the
# value safe inside the interpolated DATABASE_URL).
POSTGRES_USER=jiangtang
POSTGRES_PASSWORD=
POSTGRES_DB=jiangtang
# Upload encryption key (AES-256-GCM for every stored object). Required in production:
# compose refuses to render/start without it, and the app fails on the first
# encrypt/decrypt use. Generate: openssl rand -hex 32
# Custody: keep a durable offline copy. Losing it makes all stored uploads unreadable,
# and a different key cannot decrypt existing objects. Never commit the real value.
STORAGE_ENCRYPTION_KEY=
# Optional scrypt salt override. It affects only a passphrase-style STORAGE_ENCRYPTION_KEY
# (not 64 hex chars). Set it on a FRESH install only: changing it later makes existing
# encrypted uploads undecryptable. Leave blank to use the built-in default salt.
STORAGE_KEY_SALT=
# First-admin bootstrap. It acts only while no active ADMIN exists (first install, or
# recovery after a full lockout); once an active admin exists these values are ignored,
# so they may stay set or be removed. Blank = no bootstrap at all.
# A missing ADMIN_EMAIL account is created with ADMIN_PASSWORD. An existing one is re-elevated
# only when ADMIN_PASSWORD matches its current password; a mismatch logs an error and changes
# nothing. A set ADMIN_PASSWORD starting with change-me, or shorter than 8 characters, stops
# production boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_INITIALS=
# Set to true to make two-factor authentication (TOTP) mandatory for admins: an admin
# without it is held on "My account" until they set it up. Blank = optional for everyone.
REQUIRE_ADMIN_TWO_FACTOR=

# ── Backups (WAL-G → S3-compatible target; unset = archiving is a no-op) ──────
# WAL-G destination prefix for base backups + WAL archiving.
WALG_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint for non-AWS S3-compatible targets (Garage/RustFS/MinIO…); empty = AWS.
AWS_ENDPOINT=
AWS_REGION=eu-central-1
# Path-style addressing for self-hosted S3 targets (WAL-G needs it for MinIO).
AWS_S3_FORCE_PATH_STYLE=true
# How many FULL base backups WAL-G retains (a count, not a number of days). Must be a
# positive integer; empty is rejected. With one successful base backup per day (the
# backup sidecar's cadence), 7 keeps roughly the last 7 days. That is not a guaranteed
# window: failed or differently timed backups change it.
WALG_RETENTION_COUNT=7
# The same sidecar archives the encrypted uploads volume daily to uploads/ under the same
# prefix (ops/postgres/uploads-backup.sh). How many archives to keep, same rules as above.
UPLOADS_RETENTION_COUNT=14
# Set to 1 to run the monthly restore drill inside the backup sidecar (off by default).
# It is a restore/query/invariant SMOKE CHECK, not a source-data-equality or selected-time
# proof; its monthly marker is written only after a successful drill.
RESTORE_DRILL_ENABLED=
# Restore-time inputs. The restore service is profile-gated and never starts with the stack;
# supply these on that command line (docs/DEPLOY.md, docs/BACKUP.md) instead of setting them
# here, so a confirmation can never be inherited from this file.
# RESTORE_CONFIRM=            # must be the literal value: empty-target
# TARGET_TS=                  # optional point-in-time target, timezone-qualified
# BACKUP_NAME=                # required with TARGET_TS: a full backup named base_<24 hex>
# Image overrides. postgres + backup share one locally built image
# (pgvector pg18 + wal-g — ops/postgres/Dockerfile.walg); set these only to use
# mirrored/pre-built tags instead of the compose build.
# POSTGRES_IMAGE=jiangtang-postgres-walg:local
# BACKUP_IMAGE=jiangtang-postgres-walg:local
# ALERTING_IMAGE=alpine/curl:8.23.0

# ── AI (all optional; unset = search stays lexical, Ask unavailable) ──────────
# Embedding endpoint (OpenAI-compatible /embeddings; a keyless vLLM/Ollama is valid).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Fixed by the vector(1024) column — any other value is refused at boot.
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_SEND_DIMENSIONS=true        # false if the endpoint rejects `dimensions`
# EMBEDDING_QUERY_TEMPLATE="Instruct: {instruction}\nQuery:{text}"
# EMBEDDING_QUERY_INSTRUCTION="Given a search query in an AV and facility management workspace, retrieve the records that answer the query"
# EMBEDDING_PASSAGE_TEMPLATE="{text}"
# Reranker endpoint (Cohere/Jina/vLLM-style /rerank).
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
# Generation endpoint (OpenAI-compatible /chat/completions) — powers Ask.
GENERATION_BASE_URL=
GENERATION_MODEL=
GENERATION_API_KEY=
# GENERATION_MAX_TOKENS=800
# GENERATION_SYSTEM_ROLE=system         # or "merge" for endpoints without a system role
# "off" disables the background chunk indexer.
SEARCH_INDEXER=

# ── Calendar ──────────────────────────────────────────────────────────────────
# CalDAV push (output-only). Empty = publisher idle (Noop publisher).
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Token for the iCal feed (subscribe at /calendar/<token>/ics). At least 32 characters when set;
# the app refuses to boot in production otherwise. Empty disables the feed. Generate: openssl rand -hex 32
ICAL_FEED_TOKEN=

# ── Alerting & observability ──────────────────────────────────────────────────
# Mattermost/Slack-compatible webhook for downtime pages; empty = sidecar idles.
ALERT_WEBHOOK=
# URL the alert sidecar polls; the default already targets the app service.
# HEALTH_URL=http://app:3000/healthz
# Self-hosted GlitchTip DSN (Sentry-compatible); empty = no error tracking.
GLITCHTIP_DSN=
# pino log level (trace/debug/info/warn/error).
LOG_LEVEL=info
# Workspace UI language for visitors without a language cookie or browser preference,
# and for server-generated text (search index, Ask prompt, iCal name, demo seed): en | de.
DEFAULT_LOCALE=en

# Public landing page at /welcome. Leave blank on a team instance: visitors then only see
# /login. "1" turns it on.
LANDING_PAGE_ENABLED=
# ActivityLog retention in days (~7 years).
ACTIVITY_RETENTION_DAYS=2555

# ── Inventory ─────────────────────────────────────────────────────────────────
# Look-ahead window in days for warranties that are about to expire (default 30).
WARRANTY_WINDOW_DAYS=30
